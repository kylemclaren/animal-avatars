{
  "name": "animal-avatars",
  "version": "0.1.0",
  "description": "Animated animal avatars for React: twelve glossy 3D animals, from a tiger to a whale, with living faces that turn, hop and sleep. 2D canvas, no WebGL.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite demo --config vite.config.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "shapes": "node scripts/gen-shapes.mjs",
    "prepublishOnly": "npm run build",
    "hero": "node scripts/hero-gif.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0"
  },
  "keywords": [
    "react",
    "avatar",
    "animal",
    "tiger",
    "panda",
    "penguin",
    "whale",
    "owl",
    "animation",
    "canvas",
    "face",
    "mascot",
    "character"
  ],
  "author": "Kyle McLaren",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylemclaren/animal-avatars.git"
  },
  "bugs": {
    "url": "https://github.com/kylemclaren/animal-avatars/issues"
  },
  "homepage": "https://github.com/kylemclaren/animal-avatars#readme"
}
